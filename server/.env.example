# Copy to server/.env (git-ignored). These values stay on the server.

NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/map-runner.sqlite

# The frontend's origin(s), comma-separated. Requests from other origins are rejected.
APP_ORIGIN=http://localhost:5173

# Google sign-in: OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials - the same value as VITE_GOOGLE_CLIENT_ID.
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=519589243494-4md78gmn5dik6i9utr2gbbe1b3vgnhn1.apps.googleusercontent.com

SESSION_TTL_DAYS=30

# Production behind a reverse proxy (nginx, a PaaS router, ...): number of proxy hops, e.g. 1.
TRUST_PROXY=
# Production: serve the built frontend from this server, e.g. ../dist
CLIENT_DIST=

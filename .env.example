# Copy to `.env` (never commit it). All VITE_* values are embedded in the client
# bundle and are therefore PUBLIC - never put secrets (client secrets, tokens) here.
#
# Maps need no configuration: the app uses OpenStreetMap services, configured in
# src/config/mapServices.js.

# --- Future: accounts & integrations (require a backend) ----------------------
# Base URL of the Map Runner API. When empty the app runs in local/guest mode
# and stores data in the browser only.
VITE_API_BASE_URL=
# Google Identity Services OAuth client ID (public). Sign-in is enabled when set
# together with VITE_API_BASE_URL (the backend verifies the ID token).
VITE_GOOGLE_CLIENT_ID=
# Enable workout import providers (the OAuth flow and secrets live on the backend).
VITE_ENABLE_STRAVA=false
VITE_ENABLE_GARMIN=false

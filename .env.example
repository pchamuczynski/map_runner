# Copy to `.env` (never commit it). All VITE_* values are embedded in the client
# bundle and are therefore PUBLIC - never put secrets (client secrets, tokens) here.
#
# Maps need no configuration: the app uses OpenStreetMap services, configured in
# src/config/mapServices.js.

# --- Accounts (require the server in server/) ---------------------------------
# Where the API is reachable. "/api" = same origin (Vite proxies it to the server in
# development; in production serve both from one origin). Leave empty for a
# browser-only app without accounts.
VITE_API_BASE_URL=/api
# Google sign-in: OAuth 2.0 Client ID (public). Must match GOOGLE_CLIENT_ID in server/.env.
# Leave empty to offer email + password only.
VITE_GOOGLE_CLIENT_ID=

# --- Workout imports (require the server) -------------------------------------
# Strava and Garmin appear for signed-in users. Connecting still needs the
# server credentials in server/.env. These flags are unused.
VITE_ENABLE_STRAVA=false
VITE_ENABLE_GARMIN=false

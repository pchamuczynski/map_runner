# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/google/maps-apis/overview
# Make sure to enable the following APIs:
# - Maps JavaScript API
# - Places API  
# - Directions API
# - Geocoding API

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Set to true to use Google Maps instead of OpenStreetMap
VITE_USE_GOOGLE_MAPS=true

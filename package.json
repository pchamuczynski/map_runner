{
  "name": "map_runner_v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-dev-env.js && concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:server\" \"npm:dev:web\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "dev:web": "vite"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  },
  "engines": {
    "node": ">=22"
  }
}
